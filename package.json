{
  "name": "mahjong-with-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:visual:update": "node -e \"if(process.env.UPDATE_VISUAL_BASELINES!=='1'){console.error('Refusing baseline update without UPDATE_VISUAL_BASELINES=1 (human confirmation)');process.exit(1)}\" && playwright test e2e/visual.spec.ts --update-snapshots",
    "budget:measure": "node tools/budget/measure.mjs",
    "budget:dri": "bash tools/budget/ensure-dri-acl.sh",
    "budget:fps": "bash tools/budget/ensure-dri-acl.sh && node tools/budget/measure-fps.mjs",
    "ci": "npm run typecheck && npm run test && npm run build && npm run budget:measure && npm run test:e2e"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.6.5",
    "@types/three": "0.160.0",
    "fontkit": "^2.0.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
